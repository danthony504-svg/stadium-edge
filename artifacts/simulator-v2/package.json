{
  "name": "@workspace/simulator-v2",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --import ./test/register-hooks.mjs --test 'test/**/*.test.ts'",
    "eval:historical": "node --import ./test/register-hooks.mjs ./eval/runHistoricalValidation.ts",
    "eval:audit": "node --import ./test/register-hooks.mjs ./eval/auditCalibrationRootCause.ts",
    "eval:chrono-oos": "node --import ./test/register-hooks.mjs ./eval/runChronologicalOos.ts",
    "eval:prop-oos": "node --import ./test/register-hooks.mjs ./eval/runFootballPropOos.ts",
    "eval:prop-ab": "node --import ./test/register-hooks.mjs ./eval/runFootballPropAbHoldout.ts",
    "eval:prop-family": "node --import ./test/register-hooks.mjs ./eval/runFootballPropFamilyDiagnose.ts",
    "eval:prop-c23": "node --import ./test/register-hooks.mjs ./eval/runFootballPropC23.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
